{
    "cmake.showSystemKits": false,
    "cmake.options.statusBarVisibility": "hidden",
    "cmake.options.advanced": {
        "build": {
            "statusBarVisibility": "hidden"
        },
        "launch": {
            "statusBarVisibility": "hidden"
        },
        "debug": {
            "statusBarVisibility": "hidden"
        },
        "variant": {
            "statusBarVisibility": "hidden"
        },
        "buildTarget": {
            "statusBarVisibility": "hidden"
        }
    },
    "cmake.configureOnEdit": false,
    "cmake.automaticReconfigure": false,
    "cmake.configureOnOpen": false,
    "cmake.generator": "Ninja",
    "cmake.cmakePath": "/opt/homebrew/bin/cmake",
    "C_Cpp.debugShortcut": false,
    "terminal.integrated.env.windows": {
        "PICO_SDK_PATH": "${env:USERPROFILE}/.pico-sdk/sdk/2.3.1",
        "PICO_TOOLCHAIN_PATH": "${env:USERPROFILE}/.pico-sdk/toolchain/15_2_Rel1",
        "Path": "${env:USERPROFILE}/.pico-sdk/toolchain/15_2_Rel1/bin;${env:USERPROFILE}/.pico-sdk/picotool/2.3.1/picotool;/opt/homebrew/bin;/opt/homebrew/bin;${env:PATH}"
    },
    "terminal.integrated.env.osx": {
        "PICO_SDK_PATH": "${env:HOME}/.pico-sdk/sdk/2.3.1",
        "PICO_TOOLCHAIN_PATH": "${env:HOME}/.pico-sdk/toolchain/15_2_Rel1",
        "PATH": "${env:HOME}/.pico-sdk/toolchain/15_2_Rel1/bin:${env:HOME}/.pico-sdk/picotool/2.3.1/picotool:/opt/homebrew/bin:/opt/homebrew/bin:${env:PATH}"
    },
    "terminal.integrated.env.linux": {
        "PICO_SDK_PATH": "${env:HOME}/.pico-sdk/sdk/2.3.1",
        "PICO_TOOLCHAIN_PATH": "${env:HOME}/.pico-sdk/toolchain/15_2_Rel1",
        "PATH": "${env:HOME}/.pico-sdk/toolchain/15_2_Rel1/bin:${env:HOME}/.pico-sdk/picotool/2.3.1/picotool:/opt/homebrew/bin:/opt/homebrew/bin:${env:PATH}"
    },
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build",
        "--query-driver=/Users/*/.pico-sdk/toolchain/*/bin/arm-none-eabi-*"
    ],
    "raspberry-pi-pico.cmakeAutoConfigure": true,
    "raspberry-pi-pico.useCmakeTools": false,
    "raspberry-pi-pico.cmakePath": "/opt/homebrew/bin/cmake",
    "raspberry-pi-pico.ninjaPath": "/opt/homebrew/bin/ninja",
    "workbench.colorCustomizations": {
        "editorCursor.foreground": "#74C7EC",
        "inputValidation.errorBorder": "#74C7EC",
        "inputValidation.infoBorder": "#74C7EC",
        "inputValidation.warningBorder": "#74C7EC",
        "panelTitle.activeForeground": "#74C7EC",
        "panelTitle.activeBorder": "#74C7EC",
        "peekView.border": "#74C7EC",
        "peekViewTitleLabel.foreground": "#74C7EC",
        "tab.activeBorder": "#74C7EC",
        "tab.activeBorderTop": "#74C7EC",
        "tab.activeForeground": "#74C7EC",
        "activityBarBadge.background": "#74C7EC",
        "activityBar.activeBorder": "#74C7EC",
        "activityBar.foreground": "#74C7EC",
        "statusBarItem.remoteBackground": "#74C7EC",
        "titleBar.activeForeground": "#74C7EC",
        "titleBar.border": "#74C7EC",
        "statusBar.border": "#74C7EC",
        "statusBar.foreground": "#74C7EC",
        "editor.selectionHighlightBorder": "#74C7EC",
        "editor.selectionForeground": "#74C7EC",
        "editor.findMatchBorder": "#74C7EC",
        "editorMultiCursor.primary.foreground": "#74C7EC",
        "editorMultiCursor.secondary.foreground": "#74C7EC",
        "editorSuggestWidget.border": "#74C7EC",
        "editorLineNumber.activeForeground": "#74C7EC"
    }
}
